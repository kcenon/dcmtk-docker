# Documentation (not needed in image)
docs/
*.md
!README.md

# Git
.git/
.gitignore

# Environment (used by Docker Compose, not build)
.env

# Test data and scripts (bind-mounted at runtime, not baked into image)
data/
tests/

# README lint and its tests (CI only; COPY scripts/ would otherwise put them in the image)
scripts/readme_lint.py
scripts/tests/
