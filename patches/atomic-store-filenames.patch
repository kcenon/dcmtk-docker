--- a/dcmqrdb/libsrc/dcmqrdbi.cc
+++ b/dcmqrdb/libsrc/dcmqrdbi.cc
@@ -3259,11 +3259,31 @@
     // unsigned int seed = fnamecreator.hashString(SOPInstanceUID);
     unsigned int seed = (unsigned int)time(NULL);
     newImageFileName[0]=0; // return empty string in case of error
-    if (! fnamecreator.makeFilename(seed, handle_->storageArea, prefix, ".dcm", filename))
-        return QR_EC_IndexDatabaseError;
-
-    OFStandard::strlcpy(newImageFileName, filename.c_str(), newImageFileNameLen);
-    return EC_Normal;
+    // The filename creator only checks stat(). Forked association handlers
+    // can choose the same absent name before either saves its dataset.
+    // Reserve the path atomically on this Linux image; a successful caller
+    // owns a distinct file even when another process uses the same seed.
+    for (unsigned int attempt = 0; attempt < 1024; ++attempt)
+    {
+        if (!fnamecreator.makeFilename(seed, handle_->storageArea, prefix, ".dcm", filename)
+            || filename.length() >= newImageFileNameLen)
+            return QR_EC_IndexDatabaseError;
+
+        const int fd = open(filename.c_str(), O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, 0600);
+        if (fd < 0)
+        {
+            if (errno == EEXIST) continue;
+            return QR_EC_IndexDatabaseError;
+        }
+        if (close(fd) != 0)
+        {
+            unlink(filename.c_str());
+            return QR_EC_IndexDatabaseError;
+        }
+        OFStandard::strlcpy(newImageFileName, filename.c_str(), newImageFileNameLen);
+        return EC_Normal;
+    }
+    return QR_EC_IndexDatabaseError;
 }
 
 
